<% if notice %>
  <div class="mb-4 rounded-lg bg-green-100 text-green-800 px-4 py-3">
    <%= notice %>
  </div>
<% end %>

<div class="rounded-xl shadow-lg">
  <%= render "shared/show_actions",
    resource: @collection,
    index_path: collections_path,
    edit_path: edit_collection_path(@collection) %>

  <%= render "collection", collection: @collection %>
</div>
