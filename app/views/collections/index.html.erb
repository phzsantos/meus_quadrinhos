<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Coleção (<%= @collections.total_count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @collections.each_with_index do |collection, index| %>
          <div class="flex flex-wrap">
            <span class="p-2" >
              <%= link_to collection.name, collection %>
            </span>
            <span class="ml-auto p-2">
              <%= collection.comics.count %> 
            </span>
          </div>
          
          <% unless index == @collections.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @collections %>
</div>