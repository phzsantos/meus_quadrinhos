<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    <%= image_tag "icons/user-gear-solid-full.svg", class: "w-7 h-7 inline-block" %>
    Sala de máquinas
  </h2>
</div>

<div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
  <% @stats.each do |stat| %>
    <%= link_to stat[:path], class: "bg-bada text-center text-shadow-md p-3 rounded-md shadow-md block transition hover:opacity-90 hover:scale-[1.02]" do %>
      <h3 class="text-2xl md:text-3xl font-bold patrick-hand-regular mb-4 text-black"><%= stat[:label] %></h3>
      <p
        data-controller="counter"
        data-counter-value-value="<%= stat[:count] %>"
        class="text-4xl md:text-5xl bangers-regular text-black"
      >
        0
      </p>
    <% end %>
  <% end %>
</div>
