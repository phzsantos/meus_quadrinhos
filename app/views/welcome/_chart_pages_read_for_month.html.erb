<canvas 
  class="w-full h-full"
  data-controller="chart"
  data-chart-type-value="bar"
  data-chart-labels-value="<%= @pages_read_months.map { |m| m.strftime('%m/%Y') }.to_json %>"
  data-chart-data-value="<%= @pages_read_count_by_month.to_json %>"
  data-chart-x-title-value="Mês / Ano"
  data-chart-y-title-value="Quantidade de páginas">
</canvas>
