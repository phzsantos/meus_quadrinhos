<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    <%= image_tag 'icons/clock-solid-full.svg', class: "w-7 h-7 inline-block" %>
    Últimas leituras
  </h2>
</div>

<div>
  <div class="bg-bada p-5 text-shadow-md rounded-md shadow-md grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="md:col-span-2 space-y-3 text-black">
      <div class="grid grid-cols-3 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        <%= render "latest_reads" %>
      </div>
    </div>
  </div>  
</div>

<div class="w-full lg:col-span-2 bg-bada rounded-xl p-4 shadow-lg flex flex-col mb-6">

  <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
    Leituras dia a dia: <%= @read_comics_comparison_current_label %> × <%= @read_comics_comparison_previous_label %>
  </h2>

  <div class="flex-1 relative min-h-[350px]">
    <div class="absolute inset-0"></div>

    <div class="absolute inset-0">
      <%= render "chart_comics_read_by_day_comparison" %>
    </div>
  </div>

</div>

<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    <%= image_tag 'icons/chart-simple-solid-full.svg', class: "w-7 h-7 inline-block" %>
    Estatísticas gerais
  </h2>
</div>

<div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2 space-y-3 text-black">
      <div class="grid grid-cols-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <%= render "general_statistics" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">
      <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
        Personagens mais lidos
      </h2>

      <div class="flex-1 relative" style="min-height: <%= [350, @read_comics_characters.size * 40].max %>px">
        <div class="absolute inset-0"></div>

        <div class="absolute inset-0">
          <%= render "chart_comics_read_by_character" %>
        </div>
      </div>
    </div>

    <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">
      <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
        Autores mais lidos
      </h2>

      <div class="flex-1 relative" style="min-height: <%= [350, @read_comics_authors.size * 40].max %>px">
        <div class="absolute inset-0"></div>

        <div class="absolute inset-0">
          <%= render "chart_comics_read_by_author" %>
        </div>
      </div>
    </div>

    <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">
      <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
        Quadrinhos lidos por tipo de papel
      </h2>

      <div class="flex-1 relative" style="min-height: <%= [350, @read_comics_paper_types.size * 40].max %>px">
        <div class="absolute inset-0"></div>

        <div class="absolute inset-0">
          <%= render "chart_comics_read_by_paper_type" %>
        </div>
      </div>
    </div>

    <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">
      <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
        Quadrinhos lidos por encadernação
      </h2>

      <div class="flex-1 relative" style="min-height: <%= [350, @read_comics_book_bindings.size * 40].max %>px">
        <div class="absolute inset-0"></div>

        <div class="absolute inset-0">
          <%= render "chart_comics_read_by_book_binding" %>
        </div>
      </div>
    </div>

    <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">
      <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
        Quadrinhos lidos por editora
      </h2>
  
      <div class="flex-1 relative" style="min-height: <%= [350, @read_comics_publishers.size * 40].max %>px">
        <div class="absolute inset-0"></div>
  
        <div class="absolute inset-0">
          <%= render "chart_comics_read_by_publisher" %>
        </div>
      </div>
    </div>

    <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">
      <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
        Quadrinhos lidos por tipo de publicação
      </h2>

      <div class="flex-1 relative" style="min-height: <%= [350, @read_comics_publication_types.size * 40].max %>px">
        <div class="absolute inset-0"></div>

        <div class="absolute inset-0">
          <%= render "chart_comics_read_by_publication_type" %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    <%= image_tag 'icons/calendar-solid-full.svg', class: "w-7 h-7 inline-block" %>
    Métricas anuais
  </h2>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Quadrinhos lidos por ano
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div class="absolute inset-0">
        <%= render "chart_comics_read_by_year" %>
      </div>
    </div>

  </div>

  <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Páginas lidas por ano
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>
      
      <div class="absolute inset-0">
        <%= render "chart_pages_read_by_year" %>
      </div>
    </div>

  </div>
</div>

<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mt-6 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    <%= image_tag 'icons/calendar-days-solid-full.svg', class: "w-7 h-7 inline-block" %>
    Métricas mensais
  </h2>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  <div class="w-full lg:col-span-2 bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Quadrinhos lidos por mês
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div class="absolute inset-0">
        <%= render "chart_comics_read_by_month" %>
      </div>
    </div>

  </div>

  <div class="w-full lg:col-span-2 bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Páginas lidas por mês
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div class="absolute inset-0">
        <%= render "chart_pages_read_by_month" %>
      </div>
    </div>

  </div>

  <div class="w-full lg:col-span-2 bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Histórias lidas por mês
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div class="absolute inset-0">
        <%= render "chart_stories_read_by_month" %>
      </div>
    </div>
    
  </div>
</div>
