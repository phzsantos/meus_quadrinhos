<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black font-bold patrick-hand-regular">
    Métricas anuais:
  </h2>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Quadrinhos lidos por ano
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div data-turbo-cache="false" class="absolute inset-0">
        <%= render "chart_comics_for_year" %>
      </div>
    </div>

  </div>

  <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Páginas lidas por ano
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>
      
      <div data-turbo-cache="false" class="absolute inset-0">
        <%= render "chart_pages_read_for_year" %>
      </div>
    </div>

  </div>
</div>

<div class="bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mt-7 mb-7">
  <h2 class="text-3xl text-black font-bold patrick-hand-regular">
    Métricas mensais:
  </h2>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Quadrinhos lidos por mês
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div data-turbo-cache="false" class="absolute inset-0">
        <%= render "chart_comics_for_month" %>
      </div>
    </div>

  </div>

  <div class="w-full bg-bada rounded-xl p-4 shadow-lg flex flex-col">

    <h2 class="text-3xl text-black font-bold patrick-hand-regular mb-4 text-center shrink-0">
      Páginas lidas por mês
    </h2>

    <div class="flex-1 relative min-h-[350px]">
      <div class="absolute inset-0"></div>

      <div data-turbo-cache="false" class="absolute inset-0">
        <%= render "chart_pages_read_for_month" %>
      </div>
    </div>

  </div>
</div>
