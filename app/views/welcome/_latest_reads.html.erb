<% @latest_readings.each do |reading| %>
  <%= link_to reading.comic, class: "group" do %>
    <div class="aspect-[2/3] overflow-hidden rounded shadow-lg bg-slate-900">
      <%= image_tag(
            reading.comic.cover_image.attached? ? reading.comic.cover_image : "covers/no-cover.jpg",
            class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
          ) %>
    </div>

    <p class="mt-1 text-center truncate">
      <%= reading.comic.title %>
    </p>
    <p class="text-center truncate">
      Lido em: <%= reading.read_at.strftime("%d/%m/%Y") %>
    </p>
  <% end %>
<% end %>
