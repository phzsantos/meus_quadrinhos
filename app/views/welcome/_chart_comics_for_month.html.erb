<canvas id="comicsByMonthChart" class="w-full h-full"></canvas>

<script>
  new Chart(document.getElementById('comicsByMonthChart'), {
    type: 'bar',
    data: {
      labels: <%= raw @read_comics_months.map { |m| m.strftime("%m/%Y") }.to_json %>,
      datasets: [{
        data: <%= raw @read_comics_count_by_month.to_json %>
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        }
      },
      scales: {
        x: {
          title: {
            display: true,
            text: 'Mês / Ano'
          }
        },
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1,
            precision: 0
          },
          title: {
            display: true,
            text: 'Quantidade de quadrinhos'
          }
        }
      }
    }
  });
</script>
