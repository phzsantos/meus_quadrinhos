<div class="bg-bada p-5 text-shadow-md rounded-md shadow-md grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="md:col-span-2 space-y-3 text-black">
    <h2 class="text-5xl font-bold bangers-regular mb-4">
      <%= @publication_type.name %>
    </h2>

    <hr>

    <div class="text-3xl patrick-hand-regular">
      <p><strong>Total de quadrinhos desse tipo:</strong> <%= @publication_type.comics.count %></p>
    </div>

    <hr>

    <div class="grid grid-cols-3 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
      <% @publication_type.comics.each do |comic| %>
        <%= link_to comic, class: "group" do %>
          <div class="aspect-[2/3] overflow-hidden rounded shadow-lg bg-slate-900">
            <%= image_tag(
                  comic.cover_image.attached? ? comic.cover_image : "covers/no-cover.jpg",
                  class: "w-full h-full object-fill group-hover:scale-105 transition-transform duration-200"
                ) %>
          </div>

          <p class="mt-1 patrick-hand-regular text-xl text-shadow-md text-center truncate">
            <%= comic.title %>
          </p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
