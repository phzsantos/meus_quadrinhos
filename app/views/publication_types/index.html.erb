<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Tipo de HQ (<%= @publication_types.count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @publication_types.each_with_index do |publication_type, index| %>
          <div class="flex flex-wrap">
            <span class="p-2" >
              <%= link_to publication_type.name, publication_type %>
            </span>
            <span class="ml-auto p-2">
              <%= publication_type.comics.count %> 
            </span>
          </div>
          
          <% unless index == @publication_types.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
