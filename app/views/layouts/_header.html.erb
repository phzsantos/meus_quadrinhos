<header class="bg-black min-h-20 md:min-h-32 w-full flex items-center py-3 md:py-0">
  <div class="container mx-auto px-4 flex items-center justify-between gap-2">
    <% if user_signed_in? %>
      <div class="w-10 sm:w-38 shrink-0" aria-hidden="true"></div>
    <% end %>

    <div class="flex-1 min-w-0 text-center">
      <h1>
        <%= link_to 'Meus Quadrinhos',
          user_signed_in? ? root_path : new_user_session_path,
          class: "text-bada text-[clamp(1.5rem,6vw,4.5rem)] bangers-regular text-shadow-md whitespace-nowrap inline-block max-w-full" %>
      </h1>
    </div>

    <% if user_signed_in? %>
      <div class="flex text-black text-xl md:text-2xl bangers-regular justify-end shrink-0">
        <div data-controller="dropdown" class="relative">
          <button
            type="button"
            data-action="click->dropdown#toggle"
            class="bg-bada cursor-pointer w-10 h-10 sm:w-38 sm:h-auto py-2 px-2 rounded-md shadow-md hover:opacity-90 flex items-center justify-center sm:justify-start gap-1">
            <%= image_tag "icons/#{current_user.admin? ? 'user-gear-solid-full' : 'user-solid-full'}.svg", class: "w-7 h-7 shrink-0" %>
            <span class="hidden sm:block flex-1 text-center truncate"><%= current_user.username %></span>
          </button>

          <div
            data-dropdown-target="menu"
            class="absolute right-0 mt-2 w-38 bg-bada rounded-md shadow-lg hidden z-50">

            <%= link_to "Editar perfil",
              edit_user_registration_path,
              class: "block px-4 py-2 hover:bg-black/20" %>

            <%= link_to "Sair",
              destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "block px-4 py-2 hover:bg-black/20" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</header>

<nav class="bg-bada shadow-md">
  <div class="container mx-auto px-4">
    <ul class="flex flex-wrap justify-center gap-x-1 gap-y-0 text-xl md:text-2xl bangers-regular">
      <% if user_signed_in? %>
        <li><%= nav_link_to 'Dashboard', root_path, controllers: %w[welcome] %></li>
        <li><%= nav_link_to 'Quadrinhos', comics_path, controllers: %w[comics] %></li>
        <li><%= nav_link_to 'Coleções', collections_path, controllers: %w[collections] %></li>
        <li><%= nav_link_to 'Autores', authors_path, controllers: %w[authors] %></li>
        <li><%= nav_link_to 'Personagens', characters_path, controllers: %w[characters] %></li>
        <li><%= nav_link_to 'Editoras', publishers_path, controllers: %w[publishers] %></li>
        <li><%= nav_link_to 'Encadernações', book_bindings_path, controllers: %w[book_bindings] %></li>
        <li><%= nav_link_to 'Papel', paper_types_path, controllers: %w[paper_types] %></li>
        <li><%= nav_link_to 'Tipo', publication_types_path, controllers: %w[publication_types] %></li>
      <% end %>
    </ul>
  </div>
</nav>
