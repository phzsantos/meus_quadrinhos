<header class="bg-black h-32 w-full flex items-center">
  <div class="container mx-auto px-4 grid grid-cols-3 items-center">
    <div></div>

    <div class="text-center">
      <h1>
        <%= link_to 'Meus Quadrinhos',
          user_signed_in? ? root_path : new_user_session_path,
          class: "text-bada text-7xl bangers-regular text-shadow-md" %>
      </h1>
    </div>

    <div class="flex justify-end self-end pb-2">
      <% if user_signed_in? %>
        <%= link_to "Sair",
          destroy_user_session_path,
          data: { turbo_method: :delete },
          class: "bg-bada text-black text-xl bangers-regular px-4 py-2 rounded-md shadow-md hover:opacity-90" %>
      <% end %>
    </div>
  </div>
</header>

<nav class="bg-bada shadow-md">
  <div class="container mx-auto px-4">
    <ul class="flex justify-center space-x-4 text-2xl bangers-regular">
      <% if user_signed_in? %>
        <li><%= nav_link_to 'Dashboard', root_path, controllers: %w[welcome] %></li>
        <li><%= nav_link_to 'Quadrinhos', comics_path, controllers: %w[comics] %></li>
        <li><%= nav_link_to 'Coleções', collections_path, controllers: %w[collections] %></li>
        <li><%= nav_link_to 'Autores', authors_path, controllers: %w[authors] %></li>
        <li><%= nav_link_to 'Personagens', characters_path, controllers: %w[characters] %></li>
        <li><%= nav_link_to 'Editoras', publishers_path, controllers: %w[publishers] %></li>
        <li><%= nav_link_to 'Encadernações', book_bindings_path, controllers: %w[book_bindings] %></li>
        <li><%= nav_link_to 'Papel', paper_types_path, controllers: %w[paper_types] %></li>
        <li><%= nav_link_to 'Tipo de HQ', publication_types_path, controllers: %w[publication_types] %></li>
      <% end %>
    </ul>
  </div>
</nav>


