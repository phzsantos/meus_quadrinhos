<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin" />
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  </head>

  <body class="bg-black overflow-y-scroll">
    <%= render "layouts/header" %>
    <div class="container mx-auto bg-black/50 shadow-lg p-5 mt-3 mb-3 rounded-lg text-white">
      <% if controller_name != "welcome" %>
        <div class="bg-bada text-shadow-md p-3 rounded-md shadow-md flex flex-wrap gap-3 mb-6">
          <%= render "layouts/breadcrumb" %>
        </div>
      <% end %>
      <%= yield %>
    </div>
  </body>

  <% flash.each do |type, message| %>
    <div
      data-controller="toast"
      data-toast-message-value="<%= message %>"
      data-toast-type-value="<%= type %>">
    </div>
  <% end %>
</html>
