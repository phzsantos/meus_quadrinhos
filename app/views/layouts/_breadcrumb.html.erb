<nav class="flex items-center gap-2 w-full text-black patrick-hand-regular text-xl">
  <% if controller_name == "comic_memberships" %>
    <%= link_to t("controllers.comics"),
      comics_path,
      class: "underline hover:text-blue-700" %>
    <% if @comic.present? %>
      <span>/</span>
      <%= link_to @comic.display_title,
        comic_path(@comic),
        class: "underline hover:text-blue-700" %>
    <% end %>
    <span>/</span>
    <span class="font-bold">Adicionar leitura</span>
  <% elsif action_name != "index" %>
    <%= link_to t("controllers.#{controller_name}"),
      url_for(controller: controller_name, action: :index),
      class: "underline hover:text-blue-700" %>
  <% else %>
    <span class="font-bold"><%= t("controllers.#{controller_name}") %></span>
  <% end %>

  <% case action_name
    when "show" %>
      <% resource = instance_variable_get("@#{controller_name.singularize}") %>
      <% if resource.present? %>
        <span>/</span>
        <span class="font-bold">
          <%= resource.try(:name) || resource.try(:title) || resource.id %>
        </span>
      <% end %>

    <% when "index" %>
      <div class="ml-auto">
        <% if current_user.admin? && %w[comics collections authors characters publishers book_bindings paper_types publication_types].include?(controller_name) %>
          <%= link_to "Exportar",
            url_for(controller: controller_name, action: :export),
            target: "_blank",
            class: "px-4 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700 transition" %>
        <% end %>

        <% if controller_name == "comics" %>
          <%= link_to "Adicionar Quadrinho",
            current_user.admin? ? new_comic_path : browse_comics_path,
            class: "px-4 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition" %>
        <% elsif current_user.admin? && %w[collections authors characters publishers book_bindings paper_types publication_types].include?(controller_name) %>
          <%= link_to "Adicionar #{controller_name.classify.constantize.model_name.human}",
            url_for(controller: controller_name, action: :new),
            class: "px-4 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition" %>
        <% end %>
      </div>

    <% when "browse" %>
      <span>/</span>
      <span class="font-bold">Adicionar</span>

    <% when "edit" %>
      <% if controller_name != "comic_memberships" %>
        <% resource = instance_variable_get("@#{controller_name.singularize}") %>

        <% if resource.present? %>
          <span>/</span>
          <%= link_to resource.try(:name) || resource.try(:title) || resource.id,
            url_for(controller: controller_name, action: :show, id: resource),
            class: "underline hover:text-blue-700" %>
        <% end %>

        <span>/</span>
        <span class="font-bold">Editar</span>
      <% end %>

    <% when "new" %>
      <span>/</span>
      <span class="font-bold">Novo</span>
  <% end %>
</nav>
