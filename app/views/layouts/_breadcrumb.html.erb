<nav class="flex items-center gap-2 w-full text-black patrick-hand-regular text-xl">
  <% if action_name != "index" %>
    <%= link_to t("controllers.#{controller_name}"),
      url_for(controller: controller_name, action: :index),
      class: "underline hover:text-blue-700" %>
  <% else %>
    <span class="font-bold"><%= t("controllers.#{controller_name}") %></span>
  <% end %>

  <% case action_name
    when "show" %>
      <% resource = instance_variable_get("@#{controller_name.singularize}") %>
      <% if resource.present? %>
        <span>/</span>
        <span class="font-bold">
          <%= resource.try(:name) || resource.try(:title) || resource.id %>
        </span>
      <% end %>

    <% when "index" %>
      <% if current_user.admin? %>
        <div class="ml-auto">
          <% if %w[comics collections authors characters publishers].include?(controller_name) %>
            <%= link_to "Exportar",
              url_for(controller: controller_name, action: :export),
              target: "_blank",
              class: "px-4 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700 transition" %>
          <% end %>

          <%= link_to "Adicionar #{controller_name.classify.constantize.model_name.human}",
            url_for(controller: controller_name, action: :new),
            class: "px-4 py-2 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition" %>
        </div>
      <% end %>

    <% when "edit" %>
      <% resource = instance_variable_get("@#{controller_name.singularize}") %>

      <% if resource.present? %>
        <span>/</span>
        <%= link_to resource.try(:name) || resource.try(:title) || resource.id,
          url_for(controller: controller_name, action: :show, id: resource),
          class: "underline hover:text-blue-700" %>
      <% end %>

      <span>/</span>
      <span class="font-bold">Editar</span>


    <% when "new" %>
      <span>/</span>
      <span class="font-bold">Novo</span>
  <% end %>
</nav>
