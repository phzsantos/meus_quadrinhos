<div class="bg-bada patrick-hand-regular text-xl text-shadow-md p-3 rounded-md shadow-md flex flex-wrap gap-3 mb-6">
  <%= link_to "Voltar",
    request.referer || index_path,
    class: "px-4 py-2 bg-black/20 rounded-lg hover:bg-black/30 transition" %>

  <%= link_to resource_name,
    index_path,
    class: "px-4 py-2 bg-black rounded-lg hover:bg-black/80 transition" %>

  <% if local_assigns.fetch(:can_edit, current_user.admin?) %>
    <%= link_to local_assigns.fetch(:edit_label, "Editar"),
      edit_path,
      class: "px-4 py-2 bg-blue-600 rounded-lg hover:bg-blue-700 transition" %>
  <% end %>

  <% if current_user.admin? %>
    <div class="ml-auto">
      <%= button_to "Excluir",
        resource,
        method: :delete,
        data: { turbo_confirm: "Tem certeza?" },
        class: "px-4 py-2 bg-red-600 rounded-lg hover:bg-red-700 transition cursor-pointer" %>
    </div>
  <% end %>
</div>
