<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Autor (<%= @authors.total_count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @authors.each_with_index do |author, index| %>
          <%= link_to author, class: "block transition-colors duration-200 hover:bg-black/20" do %>
            <div class="flex flex-wrap py-2 items-center">
              <span>
                <%= author.name %>
              </span>
              <span class="ml-auto">
                <%= visible_comics_count(author) %>
              </span>
            </div>
          <% end %>
          
          <% unless index == @authors.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @authors %>
</div>