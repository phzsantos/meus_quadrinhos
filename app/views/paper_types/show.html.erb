<% if notice %>
  <div class="mb-4 rounded-lg bg-green-100 text-green-800 px-4 py-3">
    <%= notice %>
  </div>
<% end %>

<div class="rounded-xl shadow-lg">
  <%= render "shared/show_actions",
    resource: @paper_type,
    resource_name: "Tipos de Papel",
    index_path: paper_types_path,
    edit_path: edit_paper_type_path(@paper_type) %>

  <%= render "paper_type", paper_type: @paper_type %>
</div>
