<%= turbo_frame_tag "paper_types", target: "_top", data: { turbo_action: "advance" } do %>
<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <%= render "shared/search_form",
        url: paper_types_path,
        frame: "paper_types",
        input_id: "paper-type-search",
        label: "Buscar papel",
        placeholder: "Nome do papel" %>

      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Papel (<%= @paper_types.count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <% if @paper_types.empty? && params[:q].to_s.strip.present? %>
        <p class="py-4 text-2xl">Nenhum papel encontrado.</p>
      <% end %>

      <div class="text-3xl patrick-hand-regular">
        <% @paper_types.each_with_index do |paper_type, index| %>
          <%= link_to paper_type, class: "block transition-colors duration-200 hover:bg-black/20" do %>
            <div class="flex flex-wrap py-2 items-center">
              <span>
                <%= paper_type.name %>
              </span>
              <span class="ml-auto">
                <%= visible_comics_count(paper_type) %>
              </span>
            </div>
          <% end %>
          
          <% unless index == @paper_types.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>
