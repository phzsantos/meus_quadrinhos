<div class="max-w-md mx-auto text-black bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    Editar conta
  </h2>
</div>

<div class="max-w-md mx-auto text-black bg-bada p-5 text-shadow-md rounded-md shadow-md mb-6">
  <%= form_for(resource, as: resource_name,
      url: registration_path(resource_name),
      html: { method: :put, class: "space-y-4" }) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <p class="bangers-regular text-2xl font-bold"><%= f.label :username %></p>
      <%= f.text_field :username,
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div>
      <p class="bangers-regular text-2xl font-bold"><%= f.label :email %></p>
      <%= f.email_field :email,
        autocomplete: "email",
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="patrick-hand-regular text-lg opacity-70">
        Aguardando confirmação para: <%= resource.unconfirmed_email %>
      </p>
    <% end %>

    <div>
      <p class="bangers-regular text-2xl font-bold">
        <%= f.label :password %>
      </p>

      <p class="text-xl patrick-hand-regular opacity-70">
        (deixe em branco se não quiser alterar)
      </p>

      <%= f.password_field :password,
        autocomplete: "new-password",
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>

      <% if @minimum_password_length %>
        <p class="text-xl patrick-hand-regular opacity-70">
          (<%= @minimum_password_length %> caracteres mínimo)
        </p>
      <% end %>
    </div>

    <div>
      <p class="bangers-regular text-2xl font-bold"><%= f.label :password_confirmation %></p>
      <%= f.password_field :password_confirmation,
        autocomplete: "new-password",
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div>
      <p class="bangers-regular text-2xl font-bold">
        <%= f.label :current_password %>
      </p>

      <p class="text-xl patrick-hand-regular opacity-70">
        (necessário para confirmar alterações)
      </p>

      <%= f.password_field :current_password,
        autocomplete: "current-password",
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div class="pt-2 text-center">
      <%= f.submit "Atualizar conta",
        class: "w-full bg-black bangers-regular text-xl text-white px-6 py-2 rounded-md shadow-md hover:opacity-90 cursor-pointer" %>
    </div>
  <% end %>
</div>

<div class="max-w-md mx-auto text-black bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    Cancelar conta
  </h2>
</div>

<div class="max-w-md mx-auto text-black bg-bada p-5 text-shadow-md rounded-md shadow-md mb-6">
  <div class="text-center">
    <%= button_to "Excluir minha conta",
      registration_path(resource_name),
      method: :delete,
      data: { turbo_confirm: "Tem certeza que deseja excluir sua conta?" },
      class: "w-full bg-red-600 cursor-pointer text-white text-xl bangers-regular px-6 py-2 rounded-md shadow-md hover:opacity-90" %>
  </div>

  <div class="pt-3 text-center">
    <%= link_to "Voltar",
      root_path,
      class: "block w-full bg-black bangers-regular text-xl text-white px-6 py-2 rounded-md shadow-md hover:opacity-90" %>
  </div>
</div>