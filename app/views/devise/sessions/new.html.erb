<div class="max-w-md mx-auto text-black bg-bada text-shadow-md p-2 rounded-md shadow-md flex justify-center flex-wrap gap-3 mb-6">
  <h2 class="text-3xl text-black bangers-regular">
    Entrar
  </h2>
</div>

<div class="max-w-md mx-auto text-black bg-bada p-5 text-shadow-md rounded-md shadow-md mb-6">
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <p class="bangers-regular text-2xl font-bold"><%= f.label :email %></p>
      <%= f.email_field :email,
        autofocus: true,
        autocomplete: "email",
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div>
      <p class="bangers-regular text-2xl font-bold"><%= f.label :password %></p>
      <%= f.password_field :password,
        autocomplete: "current-password",
        class: "w-full rounded-md border border-gray-300 p-2 shadow-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2 pt-1">
        <%= f.check_box :remember_me, class: "w-4 h-4" %>
        <p class="patrick-hand-regular text-lg">
          <%= f.label :remember_me %>
        </p>
      </div>
    <% end %>

    <div class="text-center">
      <%= f.submit "Entrar",
        class: "w-full bg-black bangers-regular text-xl text-white px-6 py-2 rounded-md shadow-md hover:opacity-90 cursor-pointer" %>
    </div>
  <% end %>

  <div>
    <%= render "devise/shared/links" %>
  </div>
</div>