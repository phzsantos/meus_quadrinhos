<div class="bg-bada p-4 text-shadow-md rounded-md shadow-md">
  <div
    id="comics"
    class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-4"
  >
    <% @comics.each do |comic| %>
      <%= link_to comic, class: "group" do %>
        <div class="aspect-[2/3] overflow-hidden rounded-md shadow-lg bg-black/80">
          <%= image_tag(
            comic.cover_image.attached? ?
              comic.cover_image.variant(resize_to_fill: [300, 450]) :
              "covers/no-cover.jpg",
            class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
          ) %>
        </div>

        <p
          class="mt-1 text-center truncate text-black"
          title="<%= comic.title %>"
        >
          <%= comic.title %>
        </p>
      <% end %>
    <% end %>
  </div>
</div>
