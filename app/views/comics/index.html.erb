<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="py-2 text-shadow-md flex items-center gap-4 bangers-regular text-4xl">
        <span class="flex-1 min-w-0">Quadrinho (<%= @comics.total_count %>)</span>
        <div class="flex items-center shrink-0">
          <span class="w-24 text-center">Lido</span>
          <span class="w-24 text-center">Tenho</span>
          <span class="w-48 text-right">Lido em:</span>
        </div>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @comics.each_with_index do |comic, index| %>
          <% user_readings = comic.readings.select { |r| r.user_id == current_user.id && r.read_at.present? } %>
          <%= link_to comic, class: "block transition-colors duration-200 hover:bg-black/20" do %>
            <div class="flex items-center gap-4 py-2">
              <%= image_tag(
                comic.cover_image.attached? ? comic.cover_image.variant(resize_to_fill: [48, 72]) : "covers/no-cover.jpg",
                class: "w-12 h-[4.5rem] object-cover rounded shadow shrink-0",
                alt: comic.display_title,
              ) %>
              <span class="flex-1 min-w-0">
                <%= sprintf("%03d | %s", (@comics.total_count - @comics.offset_value - index), comic.display_title) %>
              </span>
              <div class="flex items-center shrink-0">
                <span class="w-24 text-center"><%= comic.read_by?(current_user) ? "Sim" : "Não" %></span>
                <span class="w-24 text-center"><%= comic.owned_by?(current_user) ? "Sim" : "Não" %></span>
                <span class="w-48 text-right">
                  <%= user_readings.sort_by(&:read_at).map { |r| l(r.read_at, format: "%d/%m/%Y") }.join(", ") %>
                </span>
              </div>
            </div>
          <% end %>

          <% unless index == @comics.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @comics %>
</div>
