<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Quadrinho (<%= @comics.total_count %>)</span>
        <span class="ml-auto">Data de leitura</span>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @comics.each_with_index do |comic, index| %>
          <%= link_to comic, class: "block transition-colors duration-200 hover:bg-black/20" do %>
            <div class="flex flex-wrap py-2 items-center">
              <span>
                <%= sprintf("%03d | %s", (@comics.total_count - @comics.offset_value - index), comic.display_title) %>
              </span>
              <span class="ml-auto">
                <%= comic.readings.sort_by(&:read_at).map { |r| l(r.read_at, format: "%d/%m/%Y") }.join(", ") %>
              </span>
            </div>
          <% end %>
          
          <% unless index == @comics.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @comics %>
</div>