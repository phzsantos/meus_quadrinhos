<% if notice %>
  <div class="mb-4 rounded-lg bg-green-100 text-green-800 px-4 py-3">
    <%= notice %>
  </div>
<% end %>

<div class="rounded-xl shadow-lg">
  <div class="bg-bada text-shadow-md p-3 rounded-md shadow-md flex flex-wrap gap-3 mb-6">
    <%= link_to "Voltar",
      comics_path,
      class: "px-4 py-2 bg-black/20 rounded-lg hover:bg-black/30 transition" %>
    
    <%= link_to "Editar",
      edit_comic_path(@comic),
      class: "px-4 py-2 bg-black rounded-lg hover:bg-black/80 transition" %>

    <div class="ml-auto">
      <%= button_to "Excluir",
        @comic,
        method: :delete,
        data: { confirm: "Tem certeza?" },
        class: "px-4 py-2 bg-red-600 rounded-lg hover:bg-red-700 transition cursor-pointer" %>
    </div>
  </div>

  <%= render "comic", comic: @comic %>
</div>
