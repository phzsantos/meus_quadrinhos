<%= form_with(model: comic, class: "bg-bada p-5 text-shadow-md rounded-md shadow-md grid grid-cols-1 md:grid-cols-3 gap-6") do |form| %>
  <div class="md:col-span-2 space-y-5 text-black">

    <h2 class="text-4xl font-bold bangers-regular">
      <%= comic.persisted? ? "Editar Quadrinho" : "Novo Quadrinho" %>
    </h2>

    <hr>

    <% if comic.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-800 rounded-md p-3">
        <ul class="list-disc list-inside text-lg patrick-hand-regular">
          <% comic.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="text-2xl patrick-hand-regular">
      <strong>Título</strong>
      <%= form.text_field :title,
        class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-2xl patrick-hand-regular">
      <div>
        <strong>Páginas</strong>
        <%= form.number_field :page_count,
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>

      <div>
        <strong>Histórias</strong>
        <%= form.number_field :story_count,
          min: 1,
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>

      <div>
        <strong>Ano</strong>
        <%= form.number_field :published_year,
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>
    </div>

    <div class="text-2xl patrick-hand-regular">
      <strong>Autores</strong>
      <%= form.collection_select :author_ids,
        Author.order(:name),
        :id,
        :name,
        {},
        {
          multiple: true,
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2 h-40"
        } %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-2xl patrick-hand-regular">
      <div>
        <strong>Editora</strong>
        <%= form.collection_select :publisher_id,
          Publisher.order(:name),
          :id,
          :name,
          { prompt: "Selecione" },
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>

      <div>
        <strong>Tipo</strong>
        <%= form.collection_select :publication_type_id,
          PublicationType.order(:name),
          :id,
          :name,
          { prompt: "Selecione" },
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>

      <div>
        <strong>Encadernação</strong>
        <%= form.collection_select :book_binding_id,
          BookBinding.order(:name),
          :id,
          :name,
          { prompt: "Selecione" },
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>

      <div>
        <strong>Papel</strong>
        <%= form.collection_select :paper_type_id,
          PaperType.order(:name),
          :id,
          :name,
          { prompt: "Selecione" },
          class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
      </div>
    </div>

    <div class="text-2xl patrick-hand-regular">
      <strong>Leituras</strong>

      <div class="space-y-2 mt-2">
        <%= form.fields_for :readings do |reading_form| %>
          <div
            data-controller="nested-reading"
            class="flex items-center gap-3"
          >
            <%= reading_form.hidden_field :id %>
            <%= reading_form.hidden_field :_destroy %>

            <%= reading_form.date_field :read_at,
              class: "rounded-md border border-black/30 px-3 py-2" %>

            <button
              type="button"
              data-action="nested-reading#remove"
              class="text-red-700 font-bold hover:text-red-900 cursor-pointer"
            >
              Remover
            </button>
          </div>
        <% end %>
      </div>

      <div class="mt-3">
        <%= form.fields_for :readings, comic.readings.build do |new_form| %>
          <%= new_form.date_field :read_at,
            class: "rounded-md border border-black/30 px-3 py-2" %>
        <% end %>
      </div>
    </div>

    <div class="text-2xl patrick-hand-regular">
      <strong>Guia dos Quadrinhos</strong>
      <%= form.url_field :link_guia_dos_quadrinhos,
        class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2",
        placeholder: "https://www.guiadosquadrinhos.com/..." %>
    </div>

    <div class="text-2xl patrick-hand-regular">
      <strong>Coleção</strong>
      <%= form.collection_select :collection_id,
        Collection.order(:name),
        :id,
        :name,
        { include_blank: "Sem coleção" },
        class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
    </div>

    <div class="flex gap-3 pt-4">
      <%= form.submit "Salvar",
        class: "px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition cursor-pointer" %>

      <%= link_to "Cancelar",
        comic.persisted? ? comic_path(comic) : comics_path,
        class: "px-6 py-2 bg-black/30 text-white rounded-md hover:bg-black/40 transition" %>
    </div>
  </div>

  <div class="flex justify-center md:justify-end">
    <div class="p-3 space-y-3">
      <div class="bg-black/80 p-3 rounded-md shadow-md">
        <%= form.file_field :cover_image,
          class: "text-white text-sm" %>
        <%= image_tag(
          comic.cover_image.attached? ?
            comic.cover_image.variant(resize_to_fill: [402, 602]) :
            "covers/no-cover.jpg",
          class: "shadow-lg w-[402px] h-[602px] object-cover"
        ) %>
      </div>
    </div>
  </div>
<% end %>
