<%= form_with(model: comic) do |form| %>
  <% if comic.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(comic.errors.count, "error") %> prohibited this comic from being saved:</h2>
      <ul>
        <% comic.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :page_count %>
    <%= form.number_field :page_count %>
  </div>

  <div>
    <%= form.label :published_year %>
    <%= form.number_field :published_year %>
  </div>

  <div class="mb-4">
    <%= form.label :story_count,
          "Histórias neste encadernado" %>

    <%= form.number_field :story_count,
          min: 1,
          step: 1 %>
  </div>

  <div>
    <%= form.label :author_ids, "Autores", class: "block font-semibold mb-1" %>

    <%= form.collection_select :author_ids,
      Author.order(:name),
      :id,
      :name,
      {},
      { multiple: true, class: "w-full rounded-lg" } %>
  </div>

  <div>
    <%= form.label :publisher_id, "Publisher" %>
    <%= form.collection_select :publisher_id, Publisher.order(:name), :id, :name,
          { prompt: "Select a publisher" } %>
  </div>

  <div>
    <%= form.label :publication_type_id, "Publication type" %>
    <%= form.collection_select :publication_type_id, PublicationType.order(:name), :id, :name,
          { prompt: "Select a publication type" } %>
  </div>

  <div>
    <%= form.label :book_binding_id, "Binding" %>
    <%= form.collection_select :book_binding_id, BookBinding.order(:name), :id, :name,
          { prompt: "Select a binding" } %>
  </div>

  <div>
    <%= form.label :paper_type_id, "Paper type" %>
    <%= form.collection_select :paper_type_id, PaperType.order(:name), :id, :name,
          { prompt: "Select a paper type" } %>
  </div>

  <div>
    <strong>Leituras:</strong>

    <%= form.fields_for :readings do |reading_form| %>
      <div
        data-controller="nested-reading"
        class="flex items-center gap-3 mb-2"
      >
        <%= reading_form.hidden_field :id %>
        <%= reading_form.hidden_field :_destroy %>

        <%= reading_form.date_field :read_at %>

        <button
          type="button"
          data-action="nested-reading#remove"
          class="text-red-600 font-semibold"
        >
          Remover
        </button>
      </div>
    <% end %>

    <!-- nova leitura -->
    <%= form.fields_for :readings, @comic.readings.build do |new_form| %>
      <div class="mt-2">
        <%= new_form.date_field :read_at %>
      </div>
    <% end %>
  </div>

  <div class="mb-4">
    <%= form.label :link_guia_dos_quadrinhos,
        "Guia dos Quadrinhos (link)",
        class: "block font-semibold mb-1" %>

    <%= form.url_field :link_guia_dos_quadrinhos,
        placeholder: "https://www.guiadosquadrinhos.com/..." %>
  </div>

  <div>
    <%= form.label :cover_image, "Cover Image" %>
    <%= form.file_field :cover_image %>
    <% if comic.cover_image.attached? %>
      <p>Current cover image:</p>
      <%= image_tag comic.cover_image.variant(resize_to_limit: [102, 155]) %>
    <% end %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
