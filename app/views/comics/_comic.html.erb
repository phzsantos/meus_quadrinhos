<div id="<%= dom_id comic %>">
  <p>
    <strong>Title:</strong>
    <%= comic.title %>
  </p>

  <p>
    <strong>Page count:</strong>
    <%= comic.page_count %>
  </p>

  <p>
    <strong>Published year:</strong>
    <%= comic.published_year %>
  </p>

  <p>
    <strong>Author:</strong>
    <%= comic.author.name %>
  </p>

  <p>
    <strong>Publisher:</strong>
    <%= comic.publisher.name %>
  </p>

  <p>
    <strong>Publication type:</strong>
    <%= comic.publication_type.name %>
  </p>

  <p>
    <strong>Book binding:</strong>
    <%= comic.book_binding.name %>
  </p>

  <p>
    <strong>Paper type:</strong>
    <%= comic.paper_type.name %>
  </p>

  <% if comic.cover_image.attached? %>
    <%= image_tag comic.cover_image.variant(resize_to_limit: [102, 155]) %>
  <% else %>
    <p>No cover uploaded</p>
  <% end %>
</div>
