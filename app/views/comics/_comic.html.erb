<div id="<%= dom_id comic %>">
  <p>
    <strong>Title:</strong>
    <%= comic.title %>
  </p>

  <p>
    <strong>Page count:</strong>
    <%= comic.page_count %>
  </p>

  <p>
    <strong>Published year:</strong>
    <%= comic.published_year %>
  </p>

  <p>
    <strong>Author:</strong>
    <%= comic.author_id %>
  </p>

  <p>
    <strong>Publisher:</strong>
    <%= comic.publisher_id %>
  </p>

  <p>
    <strong>Publication type:</strong>
    <%= comic.publication_type_id %>
  </p>

  <p>
    <strong>Book binding:</strong>
    <%= comic.book_binding_id %>
  </p>

  <p>
    <strong>Paper type:</strong>
    <%= comic.paper_type_id %>
  </p>

</div>
