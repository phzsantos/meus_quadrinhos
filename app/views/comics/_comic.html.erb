<div class="bg-bada p-5 text-shadow-md rounded-md shadow-md grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="md:col-span-2 space-y-3 text-black">
    <h2 class="text-5xl font-bold bangers-regular mb-4">
      <%= @comic.title %>
    </h2>

    <hr>

    <div class="text-3xl patrick-hand-regular">
      <p><strong>Páginas:</strong> <%= @comic.page_count %></p>
      <p><strong>Histórias compiladas:</strong> <%= @comic.story_count %></p>
      <p><strong>Ano:</strong> <%= @comic.published_year %></p>
      <p>
        <strong>Autores:</strong>
        <%= safe_join(
          @comic.authors.order(:name).map do |author|
            link_to author.name, author, class: "text-blue-600 underline hover:text-blue-800"
          end,
          ", "
        ) %>
      </p>
      <% if @comic.characters.any? %>
        <p>
          <strong>Personagens:</strong>
          <%= safe_join(
            @comic.characters.order(:name).map do |character|
              link_to character.name, character, class: "text-blue-600 underline hover:text-blue-800"
            end,
            ", "
          ) %>
        </p>
      <% end %>
      <p>
        <strong>Editora:</strong>
        <%= link_to @comic.publisher.name, @comic.publisher, class: "text-blue-600 underline hover:text-blue-800" %></p>
      <p>
        <strong>Tipo:</strong>
        <%= link_to @comic.publication_type.name, @comic.publication_type, class: "text-blue-600 underline hover:text-blue-800" %></p>
      <p>
        <strong>Encadernação:</strong>
        <%= link_to @comic.book_binding.name, @comic.book_binding, class: "text-blue-600 underline hover:text-blue-800" %></p>
      <p>
        <strong>Papel:</strong>
        <%= link_to @comic.paper_type.name, @comic.paper_type, class: "text-blue-600 underline hover:text-blue-800" %>
      </p>
      <% if @comic.collection.present? %>
        <p>
          <strong>Coleção:</strong>
          <%= link_to @comic.collection, class: "text-blue-600 underline hover:text-blue-800" do %>
            <%= @comic.collection.name %>
          <% end %>
        </p>
      <% end %>
      <% if @comic.readings.any? %>
        <p>
          <strong>Lido em:</strong>
          <%= @comic.readings.order(read_at: :asc).map { |r| l(r.read_at, format: "%d/%m/%Y") }.join(", ") %>
        </p>
      <% end %>
      <% if @comic.link_guia_dos_quadrinhos.present? %>
        <p>
          <strong>Guia dos Quadrinhos:</strong>
          <a href="<%= @comic.link_guia_dos_quadrinhos %>" target="_blank", rel="noopener", class="text-blue-600 underline hover:text-blue-800">
            Link
          </a>
        </p>
      <% end %>
    </div>
  </div>

  <div class="flex justify-center md:justify-end">
    <div class="bg-black/80 p-3 rounded-md shadow-md">
      <%= image_tag(
        @comic.cover_image.attached? ?
          @comic.cover_image : "covers/no-cover.jpg",
        class: "shadow-lg w-[402px] h-[602px] object-fill"
      ) %>
    </div>
  </div>
</div>