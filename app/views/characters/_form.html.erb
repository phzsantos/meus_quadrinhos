<%= form_with(model: character, class: "bg-bada text-black p-5 text-shadow-md rounded-md shadow-md") do |form| %>
  <h2 class="text-4xl font-bold bangers-regular mb-4 text-black">
    <%= character.persisted? ? "Editar Personagem" : "Novo Personagem" %>
  </h2>

  <hr class="mb-4">

  <% if character.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-800 rounded-md p-3 mb-4">
      <ul class="list-disc list-inside text-lg patrick-hand-regular">
        <% character.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="text-2xl patrick-hand-regular mb-6 text-black">
    <strong>Nome</strong>
    <%= form.text_field :name,
      autofocus: true,
      class: "w-full mt-1 rounded-md border border-black/30 px-3 py-2" %>
  </div>

  <div class="flex gap-3">
    <%= form.submit "Salvar",
      class: "px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition cursor-pointer" %>

    <%= link_to "Cancelar",
      character.persisted? ? character : characters_path,
      class: "px-6 py-2 bg-black/30 text-white rounded-md hover:bg-black/40 transition" %>
  </div>
<% end %>
