<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Personagem (<%= @characters.total_count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @characters.each_with_index do |character, index| %>
          <%= link_to character, class: "block transition-colors duration-200 hover:bg-black/20" do %>
            <div class="flex flex-wrap py-2 items-center">
              <span>
                <%= character.name %>
              </span>
              <span class="ml-auto">
                <%= character.comics.size %>
              </span>
            </div>
          <% end %>

          <% unless index == @characters.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @characters %>
</div>