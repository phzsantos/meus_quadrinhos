<%= turbo_frame_tag "publishers", target: "_top", data: { turbo_action: "advance" } do %>
<div class="bg-bada p-3 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <%= render "shared/search_form",
        url: publishers_path,
        frame: "publishers",
        input_id: "publisher-search",
        label: "Buscar editora",
        placeholder: "Nome da editora" %>

      <div class="py-2 text-shadow-md flex flex-wrap bangers-regular text-4xl">
        <span>Editora (<%= @publishers.total_count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <% if @publishers.empty? && params[:q].to_s.strip.present? %>
        <p class="py-4 text-2xl">Nenhuma editora encontrada.</p>
      <% end %>

      <div class="text-3xl patrick-hand-regular">
        <% @publishers.each_with_index do |publisher, index| %>
          <%= link_to publisher, class: "block transition-colors duration-200 hover:bg-black/20" do %>
            <div class="flex flex-wrap py-2 items-center">
              <span>
                <%= publisher.name %>
              </span>
              <span class="ml-auto">
                <%= visible_comics_count(publisher) %>
              </span>
            </div>
          <% end %>
          
          <% unless index == @publishers.size - 1 %>
            <hr>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="mt-6 flex justify-center">
  <%= paginate @publishers %>
</div>
<% end %>