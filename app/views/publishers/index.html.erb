<div class="bg-bada p-5 text-shadow-md rounded-md shadow-md">
  <div class="text-black">
    <div class="text-3xl patrick-hand-regular">
      <div class="flex flex-wrap bangers-regular text-4xl">
        <span class="p-2 text-shadow-md">Editora (<%= @publishers.count %>)</span>
        <span class="ml-auto">Volumes</span>
      </div>

      <hr>

      <div class="text-3xl patrick-hand-regular">
        <% @publishers.each do |publisher| %>
          <div class="flex flex-wrap">
            <span class="p-2" >
              <%= link_to publisher.name, publisher %>
            </span>
            <span class="ml-auto p-2">
              <%= publisher.comics.count %> 
            </span>
          </div>
          <hr>
        <% end %>
      </div>
    </div>
  </div>
</div>
