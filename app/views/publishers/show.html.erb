<% if notice %>
  <div class="mb-4 rounded-lg bg-green-100 text-green-800 px-4 py-3">
    <%= notice %>
  </div>
<% end %>

<div class="rounded-xl shadow-lg">
  <%= render "shared/show_actions",
    resource: @publisher,
    resource_name: "Editoras",
    index_path: publishers_path,
    edit_path: edit_publisher_path(@publisher) %>

  <%= render "publisher", publisher: @publisher %>
</div>
