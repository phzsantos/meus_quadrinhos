<%= form_with model: @comic, url: comic_membership_path(@comic), method: :patch, class: "bg-bada p-5 text-shadow-md rounded-md shadow-md space-y-5 text-black" do |form| %>
  <h2 class="text-4xl font-bold bangers-regular">
    Editar na sua coleção
  </h2>

  <hr>

  <% if @comic.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-800 rounded-md p-3">
      <ul class="list-disc list-inside text-lg patrick-hand-regular">
        <% @comic.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="text-3xl patrick-hand-regular">
    <strong><%= @comic.display_title %></strong>
  </p>

  <div class="text-2xl patrick-hand-regular">
    <%= hidden_field_tag "membership[owned]", "0" %>
    <label class="inline-flex items-center gap-3 cursor-pointer">
      <%= check_box_tag "membership[owned]", "1", @comic.owned_by?(current_user), class: "w-5 h-5" %>
      <span><strong>Tenho</strong> este quadrinho</span>
    </label>
  </div>

  <div class="text-2xl patrick-hand-regular">
    <strong>Leituras</strong>

    <div class="space-y-2 mt-2">
      <%= form.fields_for :readings, @existing_readings do |reading_form| %>
        <div
          data-controller="nested-reading"
          class="flex items-center gap-3"
        >
          <%= reading_form.hidden_field :id %>
          <%= reading_form.hidden_field :_destroy %>

          <%= reading_form.date_field :read_at,
            class: "rounded-md border border-black/30 px-3 py-2" %>

          <button
            type="button"
            data-action="nested-reading#remove"
            class="text-red-700 font-bold hover:text-red-900 cursor-pointer"
          >
            Remover
          </button>
        </div>
      <% end %>
    </div>

    <div class="mt-3">
      <p class="mb-1 text-xl opacity-80">Adicionar leitura</p>
      <%= form.fields_for :readings, @new_reading do |new_form| %>
        <%= new_form.date_field :read_at,
          class: "rounded-md border border-black/30 px-3 py-2" %>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= form.submit "Salvar",
      class: "patrick-hand-regular text-xl text-shadow-md px-6 py-2 bg-green-600 text-white rounded-md hover:bg-green-700 transition cursor-pointer" %>

    <%= link_to "Cancelar",
      comic_path(@comic),
      class: "patrick-hand-regular text-xl text-shadow-md px-6 py-2 bg-black/30 text-white rounded-md hover:bg-black/40 transition" %>
  </div>
<% end %>
