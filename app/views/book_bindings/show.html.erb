<% if notice %>
  <div class="mb-4 rounded-lg bg-green-100 text-green-800 px-4 py-3">
    <%= notice %>
  </div>
<% end %>

<div class="rounded-xl shadow-lg">
  <%= render "shared/show_actions",
    resource: @book_binding,
    resource_name: "Encadernações",
    index_path: book_bindings_path,
    edit_path: edit_book_binding_path(@book_binding) %>

  <%= render "book_binding", book_binding: @book_binding %>
</div>
